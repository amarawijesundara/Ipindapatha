// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Multi-Tenant Models
model Tenant {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  subdomain   String   @unique @db.VarChar(50)
  domain      String?  @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  
  // Relations
  users               User[]
  bookings           Booking[]
  bookingAvailability BookingAvailability[]
  refreshTokens      RefreshToken[]
  tenantUsers        TenantUser[]
  tenantSettings     TenantSettings?
  tenantSubscription TenantSubscription?
  availabilityTemplates AvailabilityTemplate[]
  availabilityOverrides AvailabilityOverride[]
  recurringBookings  RecurringBooking[]
  bookingPayments    BookingPayment[]
  paymentReceipts    PaymentReceipt[]
  
  @@index([subdomain])
  @@index([isActive])
  @@map("tenants")
}

model TenantUser {
  id       Int    @id @default(autoincrement())
  tenantId Int    @map("tenant_id")
  userId   Int    @map("user_id")
  role     String @default("user") @db.VarChar(20)
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  
  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([role])
  @@map("tenant_users")
}

model TenantSettings {
  id               Int     @id @default(autoincrement())
  tenantId         Int     @unique @map("tenant_id")
  businessHours    Json?   @map("business_hours")
  bookingRules     Json?   @map("booking_rules")
  customFields     Json?   @map("custom_fields")
  branding         Json?   @map("branding")
  notifications    Json?   @map("notifications")
  features         Json?   @map("features")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  
  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@map("tenant_settings")
}

model TenantSubscription {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @unique @map("tenant_id")
  plan            String   @db.VarChar(50)
  status          String   @default("active") @db.VarChar(20)
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  maxUsers        Int      @default(10) @map("max_users")
  maxBookings     Int      @default(1000) @map("max_bookings")
  features        Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  
  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([plan])
  @@index([status])
  @@map("tenant_subscriptions")
}

model User {
  id           Int       @id @default(autoincrement())
  tenantId     Int?      @map("tenant_id") // Nullable for platform super admins
  username     String    @db.VarChar(50)
  email        String    @db.VarChar(100)
  password     String    @db.VarChar(255)
  role         String    @default("user") @db.VarChar(20)
  phoneNumber  String?   @map("phone_number") @db.VarChar(20)
  address      String?   @db.Text
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  
  // Relations
  tenant        Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  refreshTokens RefreshToken[]
  tenantUsers   TenantUser[]
  platformSettingsUpdates PlatformSettings[]
  adminAuditLogs AdminAuditLog[]
  availabilityOverrides AvailabilityOverride[]
  recurringBookings RecurringBooking[]
  bookingPayments BookingPayment[]
  paymentReceipts PaymentReceipt[]
  paymentVerifications BookingPayment[] @relation("PaymentVerifier")
  receiptReviews PaymentReceipt[] @relation("ReceiptReviewer")
  
  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([username])
  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Booking {
  id                Int              @id @default(autoincrement())
  tenantId          Int              @map("tenant_id")
  userId            Int              @map("user_id")
  bookingDate       DateTime         @map("booking_date") @db.Date
  bookingTime       DateTime         @map("booking_time") @db.Time(6)
  eventNote         String?          @map("event_note") @db.Text
  status            String           @default("pending") @db.VarChar(20)
  offeringType      String           @default("food_preparation") @map("offering_type") @db.VarChar(20) // 'food_preparation' or 'monetary_donation'
  isRecurring       Boolean          @default(false) @map("is_recurring")
  recurringBookingId Int?            @map("recurring_booking_id")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  
  // Relations
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringBooking  RecurringBooking? @relation(fields: [recurringBookingId], references: [id], onDelete: SetNull)
  bookingPayment    BookingPayment?
  
  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, bookingDate])
  @@index([tenantId, status])
  @@index([tenantId, bookingDate, bookingTime])
  @@index([offeringType])
  @@index([isRecurring])
  @@index([recurringBookingId])
  @@map("bookings")
}

model BookingAvailability {
  id           Int       @id @default(autoincrement())
  tenantId     Int       @map("tenant_id")
  date         DateTime  @db.Date
  timeSlot     DateTime  @map("time_slot") @db.Time(6)
  isAvailable  Boolean   @default(true) @map("is_available")
  maxBookings  Int       @default(1) @map("max_bookings")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  
  // Relations
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, date, timeSlot])
  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, isAvailable])
  @@map("booking_availability")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  tenantId  Int       @map("tenant_id")
  userId    Int       @map("user_id")
  token     String    @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  
  // Relations
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// Platform Administration Models
model PlatformSettings {
  id          Int      @id @default(autoincrement())
  settingKey  String   @unique @map("setting_key") @db.VarChar(100)
  settingValue String  @map("setting_value") @db.Text
  settingType String   @map("setting_type") @db.VarChar(20)
  isActive    Boolean  @default(true) @map("is_active")
  updatedBy   Int?     @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  
  // Relations
  updatedByUser User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)
  
  @@index([settingKey])
  @@index([isActive])
  @@map("platform_settings")
}

model AdminAuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  action     String   @db.VarChar(100)
  targetType String   @map("target_type") @db.VarChar(50)
  targetId   Int?     @map("target_id")
  details    Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_audit_log")
}

model RecurringBooking {
  id           Int      @id @default(autoincrement())
  tenantId     Int      @map("tenant_id")
  userId       Int      @map("user_id")
  bookingMonth Int      @map("booking_month") // 1-12
  bookingDay   Int      @map("booking_day")   // 1-31
  bookingTime  DateTime @map("booking_time") @db.Time(6)
  eventNote    String?  @map("event_note") @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  
  // Relations
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings     Booking[] // Associated yearly booking instances
  
  @@unique([tenantId, bookingMonth, bookingDay, bookingTime])
  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, bookingMonth, bookingDay])
  @@index([tenantId, isActive])
  @@index([bookingMonth, bookingDay, bookingTime])
  @@map("recurring_bookings")
}

// Availability Template System
model AvailabilityTemplate {
  id           Int       @id @default(autoincrement())
  tenantId     Int       @map("tenant_id")
  name         String    @db.VarChar(100)
  description  String?   @db.Text
  daysOfWeek   Int[]     @map("days_of_week") // [1,2,3,4,5] for Mon-Fri (1=Monday, 7=Sunday)
  timeSlots    String[]  @map("time_slots")   // ['09:00', '10:00', '11:00', '14:00', '15:00']
  maxBookings  Int       @default(1) @map("max_bookings")
  isActive     Boolean   @default(true) @map("is_active")
  priority     Int       @default(0) // Higher priority templates override lower ones
  validFrom    DateTime? @map("valid_from") @db.Date
  validUntil   DateTime? @map("valid_until") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  
  // Relations
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, priority])
  @@index([validFrom, validUntil])
  @@map("availability_templates")
}

model AvailabilityOverride {
  id           Int       @id @default(autoincrement())
  tenantId     Int       @map("tenant_id")
  date         DateTime  @db.Date
  timeSlot     String?   @map("time_slot") @db.VarChar(8) // Nullable for full-day overrides
  overrideType String    @map("override_type") @db.VarChar(20) // 'disable', 'enable', 'modify_capacity'
  maxBookings  Int?      @map("max_bookings") // For capacity modifications
  reason       String?   @db.Text
  isActive     Boolean   @default(true) @map("is_active")
  createdBy    Int       @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  
  // Relations
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator      User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, date, timeSlot]) // Prevent duplicate overrides
  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, overrideType])
  @@index([createdBy])
  @@map("availability_overrides")
}

// Payment System Models
model BookingPayment {
  id              Int       @id @default(autoincrement())
  bookingId       Int       @unique @map("booking_id")
  tenantId        Int       @map("tenant_id")
  userId          Int       @map("user_id")
  amount          Decimal   @db.Decimal(10,2)
  currency        String    @default("USD") @db.VarChar(3)
  paymentDeadline DateTime  @map("payment_deadline") @db.Timestamp(6)
  status          String    @default("pending") @db.VarChar(20) // 'pending', 'paid', 'verified', 'overdue', 'cancelled'
  paidAt          DateTime? @map("paid_at") @db.Timestamp(6)
  verifiedAt      DateTime? @map("verified_at") @db.Timestamp(6)
  verifiedBy      Int?      @map("verified_by")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  
  // Relations
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifier        User?     @relation("PaymentVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)
  receipts        PaymentReceipt[]
  
  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([paymentDeadline])
  @@index([tenantId, status])
  @@index([verifiedBy])
  @@map("booking_payments")
}

model PaymentReceipt {
  id              Int       @id @default(autoincrement())
  paymentId       Int       @map("payment_id")
  tenantId        Int       @map("tenant_id")
  userId          Int       @map("user_id")
  fileName        String    @map("file_name") @db.VarChar(255)
  originalName    String    @map("original_name") @db.VarChar(255)
  filePath        String    @map("file_path") @db.VarChar(500)
  fileSize        Int       @map("file_size")
  mimeType        String    @map("mime_type") @db.VarChar(100)
  status          String    @default("pending") @db.VarChar(20) // 'pending', 'approved', 'rejected'
  rejectionReason String?   @map("rejection_reason") @db.Text
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamp(6)
  reviewedBy      Int?      @map("reviewed_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  
  // Relations
  payment         BookingPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer        User?     @relation("ReceiptReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  
  @@index([paymentId])
  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([reviewedBy])
  @@map("payment_receipts")
}
